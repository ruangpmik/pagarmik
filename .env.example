# ---- Database (PostgreSQL + pgvector, production) ----
DATABASE_URL="postgresql://pagarmik:pagarmik@localhost:5432/pagarmik?schema=public"

# ---- Auth ----
AUTH_SECRET="ganti-dengan-secret-min-32-karakter"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- AI provider abstraction (pilih salah satu, opsional untuk MVP) ----
# Tanpa key, PAGARMIK AI berjalan dalam mode extractive-RAG (retrieval asli + jawaban tersusun dari chunk ter-retrieve, tanpa LLM).
AI_PROVIDER="extractive" # extractive | openai-compatible | ollama
AI_BASE_URL="http://localhost:11434/v1"
AI_API_KEY=""
AI_MODEL="llama3.1:8b"
EMBEDDING_PROVIDER="local-tfidf" # local-tfidf | openai-compatible
EMBEDDING_BASE_URL="http://localhost:11434/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="nomic-embed-text"

# ---- Storage (S3-compatible, production) ----
S3_ENDPOINT=""
S3_BUCKET="pagarmik-docs"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RATE_LIMIT_PER_MINUTE="60"
